# Public base URL of the app; OAuth redirect URIs are {APP_URL}/api/v1/integrations/{appId}/callback
# On Vercel it defaults to the project's production domain (VERCEL_PROJECT_PRODUCTION_URL).
APP_URL=http://localhost:3000
# On Vercel use the provider's pooled connection string (Neon "-pooler" host, Supabase port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agere
# Migrations run on production builds; 1 forces them on other builds, 0 turns them off.
# MIGRATE_ON_BUILD=

# 32 random bytes, base64 (openssl rand -base64 32). Key id lets you rotate: add a new id and
# keep the old one in INTEGRATION_ENCRYPTION_KEYS until every token is re-encrypted.
INTEGRATION_ENCRYPTION_KEY_ID=k1
INTEGRATION_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Refresh tokens expiring within this many minutes on each cron run. 10 for a 5-minute schedule
# (Pro); 1500 for the once-a-day schedule Hobby plans allow.
CRON_REFRESH_WINDOW_MINUTES=10

# Staging only, until login exists (PRD-01): with a password set, the whole app asks for it
# (HTTP Basic, any user name) and runs as the DEV_* user and organization below.
STAGING_PASSWORD=

# There is no identity module yet (PRD-01). Locally, DEV_AUTH=1 runs every request as this user
# in this organization with this role (ignored in production builds). STAGING_PASSWORD uses the
# same three values.
DEV_AUTH=1
DEV_ORGANIZATION_ID=00000000-0000-7000-8000-000000000001
DEV_USER_ID=00000000-0000-7000-8000-000000000002
DEV_ROLE=owner

# OAuth apps. An app without credentials shows as "Not configured" in the App Center.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# One Microsoft Entra app can serve Teams, OneDrive and Outlook Calendar; per-app vars override it.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# One Google Cloud OAuth client can serve Drive and Calendar; per-app vars override it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Picker needs a browser API key and the Cloud project number
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
